{
  "extends": ["@vmb/config/tsconfig.base.json", "$app/tsconfig"],
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "types": ["$app/types", "node", "vitest/globals"],
    // SvelteKit writes $app/tsconfig per run, pointing rootDirs at that run's
    // outDir; `build` and `test` use their own (#286). Pin typecheck's to the
    // `.svelte-kit` that `sync` writes, whichever task wrote it last.
    "rootDirs": [".", "./.svelte-kit/types"]
  },
  "include": ["src", "*.ts", "*.js"],
  "exclude": ["src/service-worker"]
}

{
  "name": "@vmb/web",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "printf 'CLIENT_IP_SECRET=%s\\n' \"$(fnox get CLIENT_IP_SECRET)\" > .dev.vars",
    "dev": "vite dev",
    "build": "SVELTE_KIT_OUT_DIR=.svelte-kit/build vite build",
    "sync": "svelte-kit sync",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "SVELTE_KIT_OUT_DIR=.svelte-kit/test vitest run",
    "lint": "eslint .",
    "deploy": "wrangler pages deploy .svelte-kit/cloudflare"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.71.0",
    "better-auth": "^1.7.20",
    "bits-ui": "^2.21.0",
    "cn": "^0.5.2",
    "formsnap": "^2.1.0",
    "hono": "^4.13.17",
    "mode-watcher": "^1.1.0",
    "svelte-sonner": "^1.2.3",
    "sveltekit-superforms": "^3.1.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.12.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "@vmb/api": "workspace:*",
    "@vmb/config": "workspace:*",
    "@vmb/types": "workspace:*",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "playwright": "^1.65.0",
    "shadcn-svelte": "^1.8.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-browser-svelte": "^3.1.0",
    "wrangler": "^4.160.0"
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "sync": {
      "outputs": [".svelte-kit/generated/**", ".svelte-kit/types/**", "node_modules/$app/**"]
    },
    "build": {
      "dependsOn": ["^build", "sync"],
      "outputs": [".svelte-kit/cloudflare/**", ".svelte-kit/build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "sync"]
    },
    "test": {
      "dependsOn": ["^build", "sync"]
    }
  }
}

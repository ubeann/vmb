{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "sync": {
      "outputs": [
        ".svelte-kit/ambient.d.ts",
        ".svelte-kit/env.d.ts",
        ".svelte-kit/non-ambient.d.ts",
        ".svelte-kit/tsconfig.json",
        ".svelte-kit/generated/**",
        ".svelte-kit/types/**"
      ]
    },
    "build": {
      "dependsOn": ["^build", "sync"],
      "outputs": [".svelte-kit/cloudflare/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "sync"]
    },
    "test": {
      "dependsOn": ["^build", "sync"]
    }
  }
}

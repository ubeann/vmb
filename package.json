{
  "name": "vmb",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:signatures": "pnpm audit signatures",
    "knip": "pnpm --filter @vmb/web exec svelte-kit sync && knip"
  },
  "devDependencies": {
    "@vmb/config": "workspace:*",
    "knip": "^6.40.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  }
}

    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vmb/config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }

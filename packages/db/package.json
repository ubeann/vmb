{
  "name": "@vmb/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./src/seed/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migration/cli.ts",
    "db:seed": "tsx src/seed/cli.ts",
    "test": "vitest run",
    "db:import": "tsx src/import/cli.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vmb/types": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@vmb/config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}

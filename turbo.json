{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/**", "dist/**"],
      "env": ["PUBLIC_API_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL", "TEST_DATABASE_IMAGE"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "//#format": {
      "cache": false
    },
    "//#format:check": {
      "inputs": ["$TURBO_DEFAULT$", "!migrations/**"]
    },
    "//#audit:signatures": {
      "inputs": ["pnpm-lock.yaml", "pnpm-workspace.yaml", "package.json"]
    }
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/**", "dist/**"],
      "env": ["PUBLIC_API_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!drizzle/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!drizzle/**"]
    },
    "//#format": {
      "cache": false
    },
    "//#format:check": {
      "inputs": ["$TURBO_DEFAULT$", "!packages/db/drizzle/**"]
    }
  }
}

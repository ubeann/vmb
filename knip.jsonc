{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      // Run by hand to rebuild the brand assets (see that round's README).
      "entry": ["docs/design/**/*.mjs"],
      // Resolved from apps/web's node_modules through createRequire.
      "ignoreDependencies": ["playwright"]
    },
    "apps/web": {
      // Run by hand to check pages (docs/agents/page-checks.md). SvelteKit
      // reads src/env.ts for `$app/env/*`, and vite.config.ts aliases the
      // test stubs for the unit project.
      "entry": ["scripts/*.mjs", "src/env.ts", "src/test-stubs/*.ts"]
    },
    "apps/api": {
      // `@neondatabase/serverless` is never imported here: it is pinned so
      // drizzle-orm's types resolve to the same copy @vmb/db uses (commit
      // 6a4aa9b, and the pnpm override), and knip counts it as drizzle-orm's
      // peer. `cloudflare:workers` is a Workers runtime module, not an npm package.
      "ignoreDependencies": ["cloudflare"]
    }
  },
  // Installed by mise (.mise.toml), not npm.
  "ignoreBinaries": ["fnox"],
  // shadcn-svelte registry copies: their barrels export every part so a
  // component can be dropped in whole. Unused parts are expected there, and
  // editing them would fork the registry. Unused files and deps still report.
  "ignoreIssues": {
    "apps/web/src/lib/components/ui/**": ["exports", "types"]
  }
}
